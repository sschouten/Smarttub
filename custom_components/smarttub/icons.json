{
  "entity": {
    "binary_sensor": {
      "api_connection": {
        "default": "mdi:cloud-check-outline",
        "state": {
          "off": "mdi:cloud-alert-outline"
        }
      }
    },
    "button": {
      "refresh": {
        "default": "mdi:refresh"
      },
      "sync_clock": {
        "default": "mdi:clock-check-outline"
      }
    },
    "lock": {
      "lock_temperature": {
        "default": "mdi:lock",
        "state": {
          "unlocked": "mdi:lock-open-variant"
        }
      },
      "lock_spa": {
        "default": "mdi:lock",
        "state": {
          "unlocked": "mdi:lock-open-variant"
        }
      },
      "lock_access": {
        "default": "mdi:lock",
        "state": {
          "unlocked": "mdi:lock-open-variant"
        }
      },
      "lock_maintenance": {
        "default": "mdi:lock",
        "state": {
          "unlocked": "mdi:lock-open-variant"
        }
      },
      "lock_tuning": {
        "default": "mdi:lock",
        "state": {
          "unlocked": "mdi:lock-open-variant"
        }
      }
    },
    "sensor": {
      "consecutive_failed_polls": {
        "default": "mdi:counter"
      },
      "last_poll_duration": {
        "default": "mdi:timer-outline"
      },
      "last_successful_poll": {
        "default": "mdi:cloud-clock-outline"
      },
      "signal_strength": {
        "default": "mdi:signal-cellular-3"
      },
      "signal_quality": {
        "default": "mdi:signal"
      },
      "last_wifi_connection": {
        "default": "mdi:wifi-clock"
      },
      "clock_offset": {
        "default": "mdi:clock-alert-outline"
      }
    }
  },
  "services": {
    "reset_reminder": {
      "service": "mdi:timer-sync"
    },
    "set_primary_filtration": {
      "service": "mdi:filter"
    },
    "set_secondary_filtration": {
      "service": "mdi:filter-multiple"
    },
    "snooze_reminder": {
      "service": "mdi:timer-pause"
    },
    "get_energy_usage": {
      "service": "mdi:lightning-bolt"
    },
    "set_date_time": {
      "service": "mdi:clock-edit-outline"
    }
  }
}
